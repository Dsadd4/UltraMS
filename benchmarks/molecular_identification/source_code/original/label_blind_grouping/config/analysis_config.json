    }
  },
  "splits": {
    "threshold_selection": "val",
    "locked_evaluation": "test"
  },
  "grouping": {
    "label_columns_forbidden": [
      "smiles",
      "canonical_smiles",
      "molecule_id",
      "formula"
    ],
    "deployable_columns": [
      "sample_idx",
      "mzs",
      "intensities",
      "precursor_mz",
      "adduct",
      "retention_time",
      "collision_energy"
    ],
    "precursor_round_decimals": 4,
    "retention_time_round_decimals": 2,
    "retention_time_missing_value": 0.0,
    "spectrum_top_n_peaks": 150,
    "spectrum_mz_bin_width_da": 0.02,
    "spectrum_intensity_transform": "sqrt_then_l2",
    "linkage": "complete",
    "min_group_size": 2,
    "similarity_threshold_grid": [
      0.3,
      0.4,
      0.5,
      0.6,
      0.7,
      0.8,
      0.85,
      0.9,
      0.95
    ]
  },
  "threshold_selection_rule": {
    "hidden_labels_used_only_after_groups_are_built": true,
    "minimum_validation_spectrum_weighted_purity": 0.98,
    "minimum_validation_coverage": 0.5,
    "minimum_validation_groups": 1000,
    "objective": "maximum validation coverage among feasible thresholds",
    "tie_break": "lowest similarity threshold"
  },
  "consensus": {
    "protocol": "hard_plurality_with_borda_tie_break",
    "per_spectrum_candidate_depth": 50,
    "candidate_order": "descending top1 vote count, descending normalized Borda support, lexical candidate SMILES",
