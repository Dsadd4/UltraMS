    "bootstrap_replicates": 10000,
    "bootstrap_seed": 20260722,
    "confidence_level": 0.95
  },
  "promotion_gate": {
    "minimum_test_spectrum_weighted_purity": 0.97,
    "minimum_test_coverage": 0.5,
    "minimum_test_groups": 1000,
    "require_positive_top1_gain_for_both_models": true,
    "require_top1_gain_ci_lower_bound_above_zero_for_both_models": true
  },
  "example_selection": {
    "uses_model_outcomes": true,
    "used_for_inference_or_threshold_selection": false,
    "require_pure_hidden_label_audit": true,
    "minimum_group_size": 6,
    "minimum_distinct_collision_energies": 3,
    "selection": "illustrative shared rescue: both models start below rank 1 and finish at rank 1; maximize group size, then choose precursor_mz nearest the eligible median and lexical group_id"
  }
